# ── Rust (backend) ─────────────────────────────
/backend/target
**/target/

# ── Environment / secrets ──────────────────────
.env
.env.local
*.env
!.env.example
!env.example

# ── Uploaded/generated file storage ────────────
backend/data/documents/

# ── Node / TypeScript (ledger-service, chaincode, future services) ──
node_modules/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Fabric-specific (wallets, connection profiles with secrets) ─────
**/wallet/
**/*.pem
**/*.key
!**/*.example.*

# ── Frontend (if it grows a build step later) ──
frontend/dist/
frontend/node_modules/

# ── Editor / OS noise ───────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Logs ────────────────────────────────────────
*.log